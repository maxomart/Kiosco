{
  "name": "orvex-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Orvex desktop app — POS para kioscos. Wrapper Electron de cobraorvex.com.",
  "main": "dist/main.js",
  "author": {
    "name": "Orvex",
    "email": "soporte@cobraorvex.com",
    "url": "https://cobraorvex.com"
  },
  "homepage": "https://cobraorvex.com",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/assets dist/ 2>/dev/null || true",
    "start": "npm run build && electron dist/main.js",
    "dev": "npm run build && ORVEX_DEV_URL=http://localhost:3000 electron dist/main.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -mwl",
    "release": "npm run build && electron-builder --publish always",
    "clean": "rm -rf dist build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
