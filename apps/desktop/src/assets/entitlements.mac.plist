<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- hardenedRuntime + JIT necesario para Chromium / V8 dentro de Electron. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Permite que la app reciba mensajes de Apple Events / scripting
       básico (Cmd+Tab, etc.). Sin esto algunos shortcuts no andan en
       macOS Sonoma+. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>

  <!-- Network outbound — la app necesita conectarse a cobraorvex.com.
       Sin esto, la app firmada se queda sin red. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
